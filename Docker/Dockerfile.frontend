# =========================================================================
# DOCKERFILE PRODUCCIÓN - FRONTEND CRM ARM (NEXT.JS 14)
# =========================================================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copiar dependencias
COPY crm-nextjs/package*.json ./
RUN npm ci

# Copiar código fuente y compilar
COPY crm-nextjs/ ./
RUN npm run build

# Imagen de Producción ultraligera (Standalone < 120MB)
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Copiar archivos en ambas rutas para garantizar que el servidor standalone encuentre los assets estáticos y estilos CSS
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/.next/static ./.next/standalone/.next/static
COPY --from=builder /app/public ./.next/standalone/public

EXPOSE 3000

CMD ["node", "server.js"]
